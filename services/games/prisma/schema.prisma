generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoundStatus {
  BETTING
  RUNNING
  CRASHED
  SETTLED
}

enum BetStatus {
  PLACED
  CASHED_OUT
  LOST
  REFUNDED
}

model Round {
  id              String      @id @default(uuid())
  status          RoundStatus @default(BETTING)
  crashPointCents Int
  serverSeedHash  String
  serverSeed      String?
  clientSeed      String?
  nonce           Int
  bettingEndsAt   DateTime
  startedAt       DateTime?
  crashedAt       DateTime?
  settledAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bets Bet[]

  @@index([status])
  @@index([createdAt])
}

model Bet {
  id                 String    @id @default(uuid())
  roundId            String
  playerId           String
  amountCents        BigInt
  status             BetStatus @default(PLACED)
  cashoutMultiplier  Int?
  payoutCents        BigInt?
  walletOperationId  String?
  placedAt           DateTime  @default(now())
  cashedOutAt        DateTime?

  round Round @relation(fields: [roundId], references: [id])

  @@unique([roundId, playerId])
  @@index([playerId])
  @@index([status])
}
